{
  "name": "@growth-agent/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit && echo \"worker typechecked (runs from TS source via tsx)\"",
    "start": "tsx src/main.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@growth-agent/ai": "workspace:*",
    "@growth-agent/core": "workspace:*",
    "@growth-agent/db": "workspace:*",
    "@growth-agent/observability": "workspace:*",
    "@growth-agent/services": "workspace:*",
    "bullmq": "^5.34.6",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.7.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "playwright": "^1.49.1",
    "robots-parser": "^3.0.1",
    "tsx": "^4.19.2",
    "undici": "^7.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
