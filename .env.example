# ---------------------------------------------------------------------------
# Growth Agent — environment variables
# Copy to .env and fill in. NEVER commit .env. NEVER expose server secrets to
# the browser (only NEXT_PUBLIC_* is client-visible).
#
# PRODUCTION: put these in the platform secret store, not a file. Required in
# prod for every service: NODE_ENV=production, DATABASE_URL, DIRECT_URL,
# AUTH_SECRET, ENCRYPTION_KEY, REDIS_URL. Web also needs AUTH_URL +
# NEXT_PUBLIC_APP_URL (same https:// origin) and at least ONE sign-in path
# (RESEND_API_KEY, or EMAIL_TRANSPORT=smtp + EMAIL_SERVER, or Google OAuth).
# The app also validates all of this at boot (packages/services/src/config/env.ts)
# and fails fast with a field list. Validate before every release:
#   node scripts/check-env.mjs --file .env.production --target all
# (prints names + pass/fail only — never a secret value). Full runbook:
# docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growth_agent?schema=public
# Direct (unpooled) connection used by Prisma migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/growth_agent?schema=public

# --- Auth (Auth.js / NextAuth v5) ---------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000
# Sessions are JWT (docs/DECISIONS.md ADR-0011); self-hosted, so trust the proxy Host.
AUTH_TRUST_HOST=true

# Magic-link email delivery:
#   console — dev default: prints the sign-in link to the server log (NOT sent)
#   resend  — Resend HTTP API; needs RESEND_API_KEY. Zero SMTP infrastructure.
#   smtp    — Nodemailer via EMAIL_SERVER (e.g. mailpit from docker-compose)
# PRODUCTION needs a real delivery path (resend|smtp) OR Google OAuth configured
# below — otherwise NO ONE can sign in. `check-env.mjs` blocks a prod config
# with no sign-in path.
EMAIL_TRANSPORT=console
EMAIL_FROM=Growth Agent <noreply@localhost>
EMAIL_SERVER=smtp://localhost:1025
# Resend API key — enables EMAIL_TRANSPORT=resend (also the implicit default
# when set and EMAIL_TRANSPORT is unset).
RESEND_API_KEY=

# Dev-only: a credentials sign-in for SEEDED users (owner@example.com,
# member@example.com). It is NODE_ENV-gated AND check:env blocks the value
# "true" in a production check. MUST be unset or false in production.
AUTH_DEV_LOGIN=true

# --- Encryption (for OAuth tokens at rest) ----------------------------------
# 32-byte key, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace-me

# --- AI providers ---------------------------------------------------------
# At least one key enables the analyst agents. Every path has a deterministic
# fallback, so the app runs (with reduced insight) with no key at all.
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- AI resilience + configuration (Phase 22) — all optional --------------
# Per-call deadline; a hung provider is aborted and the agent falls back.
AI_REQUEST_TIMEOUT_MS=60000
# Transient-error (429/5xx/network) retries handled by the provider SDK.
AI_MAX_RETRIES=2
# Cross-provider failover: comma list of "provider:model" tried in order after
# the primary. Only entries whose provider has a key are used.
#   AI_FALLBACK_MODELS=openai:gpt-4o-mini,google:gemini-2.0-flash
AI_FALLBACK_MODELS=
# Kill switch. AI_DISABLED=1 blocks every model call (deterministic paths only).
# AI_DISABLED_PROVIDERS is a comma list of individual providers to disable.
AI_DISABLED=
AI_DISABLED_PROVIDERS=
# Logical model roles → "provider:model". Unset = derived from AI_DEFAULT_*.
#   router: cheap classification/extraction   analyst: synthesis
#   long_context: whole-crawl reasoning       embedding: vector search
AI_MODEL_ROUTER=
AI_MODEL_ANALYST=
AI_MODEL_LONG_CONTEXT=
AI_MODEL_EMBEDDING=
# Per-user AI request throttle, in front of the per-org monthly quota.
AI_USER_RATE_LIMIT=30
AI_USER_RATE_WINDOW_SEC=60

# --- Redis / queues -----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Google OAuth (YouTube + Search Console) -------------------------------
# ONE Google Cloud OAuth Web client serves both integrations. Authorized
# redirect URI to register: ${NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
# Scopes are read-only:
#   YouTube:        youtube.readonly + yt-analytics.readonly
#                   (+ yt-analytics-monetary.readonly on the revenue opt-in)
#   Search Console: webmasters.readonly + openid + userinfo.email
# Enable the "YouTube Data API v3", "YouTube Analytics API" and "Search Console
# API" in the Cloud project. ENCRYPTION_KEY (above) is REQUIRED to store tokens.
# See docs/GOOGLE-SEARCH-CONSOLE.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Per-connection daily slice of the shared YouTube Data API quota (units).
YOUTUBE_ORG_DAILY_QUOTA=2000

# --- TikTok (Login Kit + Display API + Content Posting API) -----------------
# Redirect URI to register: ${NEXT_PUBLIC_APP_URL}/api/integrations/tiktok/callback
# Scopes requested: user.info.basic/profile/stats, video.list (+ video.publish on opt-in).
# ENCRYPTION_KEY (above) is REQUIRED. Non-private publishing needs an audited app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- SEO crawler --------------------------------------------------------------
# The crawler needs no third-party credentials. It resolves DNS itself and
# refuses private / internal / cloud-metadata addresses (docs/SECURITY.md §7).
# Kill switch: set CRAWLER_HALT=1 to stop ALL crawls; or list org ids to halt.
CRAWLER_HALT=0
CRAWLER_HALT_ORG_IDS=
# Headless rendering (renderMode AUTO/HEADLESS) runs only in the worker and
# needs Chromium: pnpm --filter @growth-agent/worker exec playwright install chromium

# --- Billing (Stripe) ---------------------------------------------------------
# All optional. With none set the app runs everyone on the FREE plan and still
# enforces its limits. Plan prices/limits live in the config catalog
# (packages/services/src/billing/plans.ts); only the Stripe Price IDs are env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# One Stripe Price ID per purchasable tier + interval:
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=
# Optional overrides: STRIPE_API_BASE_URL (default https://api.stripe.com),
#                     STRIPE_API_VERSION (default 2024-06-20)

# --- Observability -------------------------------------------------------------
LOG_LEVEL=info
METRICS_ENABLED=true
# Bearer token the Prometheus scraper presents to GET /api/metrics (web).
# Unset ⇒ that endpoint needs a platform-staff session.
METRICS_TOKEN=
# Port for the worker's /healthz + /metrics listener (default 9090). Private interface only.
WORKER_HEALTH_PORT=9090
# Client + edge-runtime errors POST to /api/client-error → the same de-duplicated
# ErrorEvent table as server errors (/admin/errors). No extra config.

# --- NOT IMPLEMENTED (planned; NO code reads these) ------------------------
# Documented here for roadmap visibility only. Do NOT provision infrastructure
# for these expecting the app to use it. See docs/FORENSIC-AUDIT.md.
#   Object storage (S3):    S3_ENDPOINT / S3_REGION / S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
#   Sentry:                 SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN   (client/edge capture uses /api/client-error instead)
#   OpenTelemetry:          OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME
#   Notifications email digests: (in-app + per-event email are implemented; weekly digests are not)

# --- App ------------------------------------------------------------------
# In production this MUST equal AUTH_URL and be the canonical https:// origin
# (the app trusts the Host header for magic-link / OAuth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backups (deploy/backup/pg-backup.sh — production only) ----------------
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_RETENTION_DAYS=30
# Required if you run pg-backup.sh — the script refuses to upload an
# unencrypted dump (a dump contains the full tenant dataset: PII, OAuth-token
# ciphertext, everything). Generate/import a GPG key and put its recipient
# (email or key id) here; keep the matching private key somewhere the backup
# host itself does NOT have access to, so a compromised host can't decrypt
# its own backups.
BACKUP_GPG_RECIPIENT=

# --- Reverse proxy (docker-compose.production.yml → Caddy) ----------------
APP_DOMAIN=
TLS_EMAIL=
