# syntax=docker/dockerfile:1.7
###############################################################################
# Growth Agent — worker image (BullMQ processors + schedulers + heartbeat).
#
#   docker build -f Dockerfile.worker -t growth-agent-worker:$(git rev-parse --short HEAD) .
#
# The monorepo consumes `packages/*` as TypeScript source, so the worker runs
# from source with `tsx` (same mechanism as `pnpm dev`) rather than a bundled
# dist. Playwright's Chromium is installed for headless SEO rendering.
# See docs/DEPLOYMENT.md §14–15.
###############################################################################

ARG NODE_VERSION=20.11.0
ARG PLAYWRIGHT_VERSION=1.49.1

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
WORKDIR /app

# --- deps: install once, cached on the lockfile -----------------------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json               apps/web/package.json
COPY apps/worker/package.json            apps/worker/package.json
COPY packages/core/package.json          packages/core/package.json
COPY packages/ai/package.json            packages/ai/package.json
COPY packages/db/package.json            packages/db/package.json
COPY packages/ui/package.json            packages/ui/package.json
COPY packages/services/package.json      packages/services/package.json
COPY packages/observability/package.json packages/observability/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline

# --- build: sources + generated Prisma client + a typecheck ----------
FROM deps AS build
COPY . .
RUN pnpm db:generate && pnpm --filter @growth-agent/worker build \
 # `prisma generate` above only fetches the *query* engine (bundled into the
 # generated client); the *schema* engine is a separate binary, needed only
 # by `prisma migrate deploy`, which never runs at build time (migrations
 # are a deliberate release step, not baked into the image). Left
 # unfetched, it lazily downloads on first real `migrate deploy` — which
 # runs as the one-shot `migrate` compose service on the `internal: true`
 # network with no internet, and fails outright (reproduced running it for
 # real). Force the download now, while this stage still has internet;
 # the command itself is expected to fail (no real database is reachable
 # at build time) — only the engine-fetch side effect matters.
 && (DATABASE_URL="postgresql://u:p@127.0.0.1:5432/d" DIRECT_URL="postgresql://u:p@127.0.0.1:5432/d" \
      pnpm --filter @growth-agent/db exec prisma migrate status || true)

# --- runner ---------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS runner
ARG PLAYWRIGHT_VERSION
ENV NODE_ENV=production WORKER_HEALTH_PORT=9090 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget \
 && rm -rf /var/lib/apt/lists/* \
 # A real, standalone global pnpm binary — not corepack's shim. This image
 # (and the one-shot `migrate` service that reuses it) runs on the compose
 # file's `internal` network with no internet access at runtime, by design,
 # and corepack's shim re-verifies its package manager against the registry
 # on every single invocation regardless of COREPACK_ENABLE_NETWORK
 # (reproduced running `migrate` for real — it still failed offline even
 # with that set). `npm install -g` needs the registry only here, at build
 # time, and produces a plain binary with no further network dependency.
 && npm install -g pnpm@10.14.0 \
 && addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 worker \
 && mkdir -p /ms-playwright && chown worker:nodejs /ms-playwright

# Whole workspace + resolved node_modules (workspace pkgs are consumed as TS
# source, so the worker needs them present, not compiled).
COPY --from=build --chown=worker:nodejs /app ./

# Chromium for headless SEO rendering (own layer — caches independently).
RUN pnpm --dir apps/worker exec playwright install --with-deps chromium

USER worker
EXPOSE 9090

# Liveness: the worker's own HTTP listener (apps/worker/src/health-server.ts).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q --spider "http://127.0.0.1:${WORKER_HEALTH_PORT}/healthz" || exit 1

CMD ["pnpm", "--filter", "@growth-agent/worker", "start"]
