# ---------------------------------------------------------------------------
# Growth Agent — STAGING environment variables.
#
# Copy to `.env.staging` ON THE STAGING HOST ONLY and fill in. NEVER commit
# `.env.staging`. NEVER put a real (`sk_live_...`) Stripe key in this file —
# staging uses Stripe TEST MODE only, enforced by convention here and by a
# manual check in docs/STAGING.md's verification checklist (this project has
# no code-level guard against a live key, so the discipline is procedural).
#
# This mirrors `.env.example` — see that file for what every variable does.
# This file only calls out what's DIFFERENT for staging. Full walkthrough:
# docs/STAGING.md. Validate with:
#   node scripts/check-env.mjs --file .env.staging --target all
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Database (Supabase Postgres) ------------------------------------------
# Supabase gives you two connection strings on the same project — use both,
# they are NOT interchangeable:
#   Connection pooling (Transaction mode, port 6543) → DATABASE_URL (runtime)
#   Direct connection (port 5432)                    → DIRECT_URL (migrations)
# Project Settings → Database → Connection string, in the Supabase dashboard.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[password]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:[password]@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Redis (Upstash) --------------------------------------------------------
# Upstash → Create database → copy the "rediss://" (TLS) connection string.
REDIS_URL=rediss://default:[token]@your-db.upstash.io:6379

# --- Auth (Auth.js / NextAuth v5) ------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=https://staging.your-domain.example
AUTH_TRUST_HOST=true
# MUST be unset/false on staging — this is a real, internet-reachable deploy.
AUTH_DEV_LOGIN=

# Pick ONE real sign-in path (staging must behave like production here —
# check-env.mjs blocks NODE_ENV=production with none configured):
EMAIL_TRANSPORT=resend
EMAIL_FROM=Growth Agent Staging <noreply@staging.your-domain.example>
RESEND_API_KEY=
# (Google OAuth below also works as a sign-in path once configured — you
# don't strictly need both, but having email too makes QA without a Google
# account possible.)

# --- Encryption (OAuth tokens at rest) --------------------------------------
# Generate: openssl rand -base64 32 — use a DIFFERENT key than production's.
ENCRYPTION_KEY=replace-me

# --- AI providers ------------------------------------------------------------
# Optional — every path has a deterministic fallback. If you do set one,
# it's a REAL key hitting the REAL provider (AI providers have no "test
# mode"); watch usage/cost, and consider a low-limit key just for staging.
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Google OAuth (YouTube + Search Console + "Sign in with Google") -------
# ONE Google Cloud OAuth Web client for all three. Register BOTH redirect
# URIs on it (NextAuth's own sign-in callback AND the integration callback):
#   https://staging.your-domain.example/api/auth/callback/google
#   https://staging.your-domain.example/api/integrations/google/callback
# Use a Testing-mode OAuth consent screen (no Google verification needed —
# add your own/QA's Google accounts as test users) — see docs/STAGING.md §7.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YOUTUBE_ORG_DAILY_QUOTA=2000

# --- TikTok ------------------------------------------------------------------
# Redirect URI to register: https://staging.your-domain.example/api/integrations/tiktok/callback
# A sandbox/unaudited TikTok app is fine for staging — video.publish (real
# posting) needs an audited app, everything else works in sandbox review.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- SEO crawler ---------------------------------------------------------------
CRAWLER_HALT=0
CRAWLER_HALT_ORG_IDS=

# --- Billing (Stripe — TEST MODE ONLY) ---------------------------------------
# Every value below MUST come from Stripe's TEST mode (the dashboard toggle,
# top-right — "Test mode"). Test keys start sk_test_ / pk_test_; test Price
# IDs and the test-mode webhook signing secret are separate from live ones
# even within the same Stripe account. NEVER paste an sk_live_/pk_live_ value
# here — see docs/STAGING.md's verification checklist for the manual check.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=

# --- Observability -------------------------------------------------------------
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_TOKEN=
WORKER_HEALTH_PORT=9090

# --- Object storage: NOT an application feature yet -------------------------
# No code in this app reads S3_* (see .env.example's "NOT IMPLEMENTED"
# section and docs/FORENSIC-AUDIT.md) — setting these does nothing. Leave
# unset. The only real object-storage use on staging is the Postgres backup
# script below, which is a separate, already-working piece of tooling.
# S3_ENDPOINT / S3_REGION / S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY

# --- App ---------------------------------------------------------------------
# MUST equal AUTH_URL exactly (same https:// origin).
NEXT_PUBLIC_APP_URL=https://staging.your-domain.example

# --- Backups (deploy/backup/pg-backup.sh) — optional on staging -------------
# Supabase already takes its own automated backups/PITR; this script is a
# portable second copy, restorable anywhere. Skip entirely (leave
# BACKUP_S3_BUCKET unset) if staging data is disposable — pg-backup.sh isn't
# invoked by anything unless you add the cron line yourself. If you DO use
# it, point BACKUP_S3_BUCKET at any S3-compatible bucket (Cloudflare R2, or
# Supabase Storage's own S3-compatible endpoint — Project Settings → Storage
# → S3 Connection) and BACKUP_GPG_RECIPIENT is then required — the script
# refuses to upload an unencrypted dump.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=

# --- Reverse proxy (docker-compose.staging.yml → Caddy) ---------------------
APP_DOMAIN=staging.your-domain.example
TLS_EMAIL=you@your-domain.example
